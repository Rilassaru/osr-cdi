# ==============================================================================
# OSR-CDI Project .gitignore
# ==============================================================================

# ==============================================================================
# 1. Circuit Folder (KiCad) - Applied strictly to circuit/
# ==============================================================================
# Temporary and backup files
circuit/**/.*.swp
circuit/**/*-backups/
circuit/**/_autosave-*
circuit/**/#auto_saved_files#
circuit/**/~*.lck
circuit/**/*.bak
circuit/**/*.bck
circuit/**/*.kicad_pcb-bak
circuit/**/*.kicad_sch-bak
circuit/**/*.tmp
circuit/**/fp-info-cache
circuit/**/*.kicad_dru

# Local project preferences (window positions, etc.)
circuit/**/*.kicad_prl

# Netlists and intermediate layout files
circuit/**/*.net
circuit/**/*.dsn
circuit/**/*.ses

# Output reports and BOM files (Allow manufacturing files for JLCPCB)
circuit/**/*.xml
circuit/**/*.csv
!circuit/**/jlcpcb/**
!circuit/**/production_files/**
!circuit/**/production/**


# ==============================================================================
# 2. Firmware Folder (MPLAB X IDE / PIC) - Applied strictly to firmware/
# ==============================================================================
# Build output directories and user-specific workspace files
firmware/**/build/
firmware/**/debug/
firmware/**/dist/
firmware/**/nbproject/private/

# Compiler intermediate files and tags
firmware/**/*.mptags
firmware/**/*.tagsrc
firmware/**/*.d
firmware/**/*.p1
firmware/**/*.i
firmware/**/*.cmf
firmware/**/*.elf
firmware/**/*.hxl
firmware/**/*.lst
firmware/**/*.map
firmware/**/*.mum
firmware/**/*.o
firmware/**/*.rlf
firmware/**/*.sdb
firmware/**/*.sym
firmware/**/*.BAK

# Explicitly track MPLAB X project definition XML files
!firmware/**/nbproject/*.xml


# ==============================================================================
# 3. WinCDI Folder (Visual Studio / C++) - Applied strictly to wincdi/
# ==============================================================================
# Visual Studio workspace cache and user-specific options
wincdi/**/.vs/
wincdi/**/*.suo
wincdi/**/*.user
wincdi/**/*.userosscache
wincdi/**/*.sln.docstates
wincdi/**/*.opendb
wincdi/**/*.VC.db
wincdi/**/*.VC.VC.opendb

# Build target directories and intermediate object folders
wincdi/**/Debug/
wincdi/**/Release/
wincdi/**/x64/
wincdi/**/x86/
wincdi/**/ipch/
wincdi/**/wincdi/Debug/
wincdi/**/wincdi/Release/

# Build artifacts, symbol files, and logs
wincdi/**/*.obj
wincdi/**/*.pdb
wincdi/**/*.idb
wincdi/**/*.ilk
wincdi/**/*.iobj
wincdi/**/*.ipdb
wincdi/**/*.pch
wincdi/**/*.res
wincdi/**/*.tlog
wincdi/**/*.log
wincdi/**/*.recipe
wincdi/**/*.lastbuildstate
wincdi/**/wincdi.vcxproj.FileListAbsolute.txt
wincdi/**/*.dt.d.json
wincdi/**/*.dt.module.json
wincdi/**/*.dt.module.json.command

# Allow third-party libraries and release installers
!wincdi/lib/**
!wincdi/InstallerProject/Release/*.msi
!wincdi/InstallerProject/Release/setup.exe


# ==============================================================================
# 4. OS & Editor Generic - Applied globally
# ==============================================================================
.DS_Store
Thumbs.db
Desktop.ini
*$*
*~
*.tmp